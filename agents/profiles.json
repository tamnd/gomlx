  "hermes": {
    "capabilities": {
      "function_calling": true,
      "reasoning": true,
      "streaming": true,
      "vision": false
    },
    "config": {
      "path": "~/.hermes/config.yaml",
      "template": "model:\n  provider: \"custom\"\n  default: \"{model_id}\"\n  base_url: \"{base_url}\"\n  context_length: 32768\n  max_tokens: 4096\nplatform_toolsets:\n  cli: [terminal, file, code_execution, web, browser, skills]\n",
      "type": "yaml"
    },
    "display_name": "Hermes Agent",
    "known_issues": [
      "todo tool conflict: Hermes injects a 'todo' tool that causes errors with Gemma 4. Fix: exclude from platform_toolsets or use -t flag",
      "Gemma 4 [Calling tool mimicry: after many tool turns, Gemma 4 parrots Hermes UI text.",
      "pip install hermes-agent may not work on all systems - clone and install from source in a venv"
    ],
    "models": {
      "parser_override": null,
      "recommended": [
        "qwen3.5-4b",
        "qwen3.5-9b",
        "gemma-4-26b",
        "qwen3.5-35b-a3b",
        "qwen3.6-35b"
      ]
    },
    "name": "hermes",
